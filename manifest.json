{
  "manifest_version": 3,
  "name": "TecPendientes Inspector",
  "version": "1.0.0",
  "description": "Detecta entregas pendientes de los cursos actuales en TecDigital.",

  "icons": {
        "16": "icons/logo16.png",
        "32": "icons/logo32.png",
        "48": "icons/logo48.png",
        "128": "icons/logo128.png"
  },

  "host_permissions": [
    "https://tecdigital.tec.ac.cr/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "TecPendientes",
    "default_icon": {
        "16": "icons/logo16.png",
        "32": "icons/logo32.png",
        "48": "icons/logo48.png"
    }
},

  "content_scripts": [
    {
      "matches": [
        "https://tecdigital.tec.ac.cr/dotlrn/index",
        "https://tecdigital.tec.ac.cr/dotlrn/"
      ],
      "js": [
        "content/utils.js",
        "content/cursos.js",
        "content/evaluaciones.js",
        "content/fechas.js",
        "content/actividades.js",
        "content/clasificacion.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}